# ── Supabase ──────────────────────────────────────────────────────────
# Client-safe (set in Vercel: Production, Preview, Development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser (Vercel: Production, Preview)
SUPABASE_SERVICE_ROLE_KEY=

# ── Offer API (prematch fixtures, server-side proxy) ───────────────────
# Optional — defaults to integration host + /fixtures/prematch
OFFER_API_PREMATCH_BASE_URL=https://st-feeds-offer-api-int.int.kingmakers.tech/api/offer-api/v1/fixtures/prematch
# Optional — example request used AreaId=1572
OFFER_API_AREA_ID=1572
# Optional — e.g. Bearer token if the environment requires auth
OFFER_API_AUTHORIZATION=
